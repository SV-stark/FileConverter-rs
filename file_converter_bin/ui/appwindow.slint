// ---------------------------------------------------------------------------
// FileConverter-rs UI.
//
// Structure: tokens (theme.slint) -> primitives (components.slint) -> rows
// defined once at the bottom of this file -> two windows.
//
// Every colour comes from Theme, every control from components.slint. Nothing
// below contains a raw hex value or a hand-built button.
// ---------------------------------------------------------------------------

import { LineEdit, ScrollView, ProgressIndicator, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ButtonKind, UiBadge, UiButton, UiCard, UiChip, UiDivider, UiFieldLabel, UiIconButton } from "components.slint";
import { Icon, IconCopy, IconDownload, IconFolder, IconFolderOpen, IconMoon, IconPlug, IconPlus, IconSave, IconSun, IconTrash, IconUpload, IconX, IconZap } from "icons.slint";

export struct PresetData {
    original_index: int,
    name: string,
    category: string,
    output_type: string,
    output_ext: string,
    input_types: string,
    output_file_name_template: string,
    input_post_conversion_action: string,
}

export struct HistoryItemData {
    timestamp: string,
    preset_name: string,
    input_path: string,
    output_path: string,
    status: string,
}

export struct JobProgressData {
    id: int,
    input_file_name: string,
    input_path: string,
    output_path: string,
    progress: float,
    status_text: string,
    is_done: bool,
    is_failed: bool,
}

// One editable conversion setting of the selected preset (quality, bitrate,
// scale, ...). `choices` is empty for free-text values.
export struct PresetSettingData {
    key: string,
    label: string,
    hint: string,
    group: string,
    value: string,
    choices: [string],
    is_custom: bool,
    is_group_start: bool,
}

// ---------------------------------------------------------------------------
// Rows and small local composites
// ---------------------------------------------------------------------------

component NavTab inherits Rectangle {
    in property <bool> dark: false;
    in property <bool> selected: false;
    in property <string> text <=> lbl.text;
    in property <image> icon;
    callback clicked();

    height: 32px;
    border-radius: Theme.r-sm;
    background: root.selected ? Theme.accentSoft(root.dark) : transparent;
    animate background { duration: Theme.fast; easing: ease-out; }

    HorizontalLayout {
        alignment: center;
        padding-left: Theme.s-3;
        padding-right: Theme.s-3;
        spacing: Theme.s-2;

        Icon {
            source: root.icon;
            size: 14px;
            tint: root.selected ? Theme.accent(root.dark) : Theme.textMute(root.dark);
        }

        lbl := Text {
            font-size: Theme.t-md;
            font-weight: root.selected ? Theme.w-semibold : Theme.w-medium;
            color: root.selected ? Theme.accent(root.dark) : Theme.textDim(root.dark);
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.selected : { background: Theme.surface3(root.dark); }
    ]
}

component PresetRow inherits Rectangle {
    in property <bool> dark: false;
    in property <bool> selected: false;
    in property <PresetData> data;
    callback clicked();

    height: 52px;
    border-radius: Theme.r-sm;
    background: root.selected ? Theme.accentSoft(root.dark) : Theme.surface2(root.dark);
    border-width: 1px;
    border-color: root.selected ? Theme.accent(root.dark) : Theme.border(root.dark);
    animate background { duration: Theme.fast; easing: ease-out; }
    animate border-color { duration: Theme.fast; easing: ease-out; }

    HorizontalLayout {
        padding-left: Theme.s-3;
        padding-right: Theme.s-2;
        spacing: Theme.s-2;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.data.name;
                font-size: Theme.t-md;
                font-weight: Theme.w-semibold;
                color: Theme.text(root.dark);
                overflow: elide;
            }
            Text {
                text: root.data.output_ext + " · " + root.data.input_types;
                font-size: Theme.t-sm;
                color: Theme.textMute(root.dark);
                overflow: elide;
                // Caps the minimum width so the elide above can take effect
                // instead of inflating the 320px sidebar.
                max-width: 210px;
            }
        }

        UiChip {
            text: root.data.category;
            dark: root.dark;
            h: 22px;
            horizontal-stretch: 0;
            interactive: false;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    states [
        hover when ta.has-hover && !root.selected : { background: Theme.surface3(root.dark); }
    ]
}

component HistoryRow inherits Rectangle {
    in property <bool> dark: false;
    in property <HistoryItemData> data;

    height: 54px;
    border-radius: Theme.r-sm;
    background: Theme.surface2(root.dark);
    border-width: 1px;
    border-color: Theme.border(root.dark);

    HorizontalLayout {
        padding-left: Theme.s-4;
        padding-right: Theme.s-4;
        spacing: Theme.s-3;

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.data.preset_name + " · " + root.data.timestamp;
                font-size: Theme.t-md;
                font-weight: Theme.w-semibold;
                color: Theme.text(root.dark);
            }
            Text {
                text: root.data.input_path;
                font-size: Theme.t-sm;
                color: Theme.textMute(root.dark);
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: Theme.s-1;
            alignment: center;
            horizontal-stretch: 0;

            Icon {
                source: root.data.status == "Done" ? @image-url("icons/check.svg") : @image-url("icons/x.svg");
                size: 13px;
                tint: root.data.status == "Done" ? Theme.success(root.dark) : Theme.danger(root.dark);
            }
            Text {
                text: root.data.status;
                font-size: Theme.t-base;
                font-weight: Theme.w-semibold;
                vertical-alignment: center;
                color: root.data.status == "Done" ? Theme.success(root.dark) : Theme.danger(root.dark);
            }
        }
    }
}

component JobRow inherits Rectangle {
    in property <bool> dark: false;
    in property <JobProgressData> data;
    callback cancel(int);

    height: 62px;
    border-radius: Theme.r-sm;
    background: Theme.surface2(root.dark);
    border-width: 1px;
    border-color: Theme.border(root.dark);

    VerticalLayout {
        padding-left: Theme.s-4;
        padding-right: Theme.s-4;
        padding-top: Theme.s-2;
        padding-bottom: Theme.s-2;
        spacing: Theme.s-1;

        HorizontalLayout {
            alignment: space-between;
            spacing: Theme.s-2;

            Text {
                text: root.data.input_file_name;
                font-size: Theme.t-md;
                font-weight: Theme.w-medium;
                color: Theme.text(root.dark);
                overflow: elide;
            }

            UiBadge {
                text: root.data.status_text;
                horizontal-stretch: 0;
                fg: root.data.is_done ? Theme.success(root.dark)
                    : root.data.is_failed ? Theme.danger(root.dark)
                    : Theme.accent(root.dark);
                bg: root.data.is_done ? Theme.successSoft(root.dark)
                    : root.data.is_failed ? Theme.dangerSoft(root.dark)
                    : Theme.accentSoft(root.dark);
            }
        }

        HorizontalLayout {
            spacing: Theme.s-2;
            alignment: space-between;

            ProgressIndicator {
                progress: root.data.progress;
                horizontal-stretch: 1;
            }

            if !root.data.is_done && !root.data.is_failed : UiButton {
                text: "Cancel";
                kind: ButtonKind.Ghost;
                dark: root.dark;
                h: 24px;
                pad-x: Theme.s-2;
                has-icon: true;
                icon: @image-url("icons/x.svg");
                clicked => { root.cancel(root.data.id); }
            }
        }
    }
}

// A single toggleable preference block.
component PrefCard inherits UiCard {
    in property <string> title;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);

    pad: Theme.s-4;
    gap: Theme.s-2;
    fill: Theme.surface2(root.dark);
    radius: Theme.r-md;

    CheckBox {
        text: root.title;
        checked <=> root.checked;
        toggled => { root.toggled(self.checked); }
    }
    Text {
        text: root.hint;
        font-size: Theme.t-base;
        color: Theme.textMute(root.dark);
        wrap: word-wrap;
    }
}

// ---------------------------------------------------------------------------
// Settings & Preset Studio
// ---------------------------------------------------------------------------

export component SettingsWindow inherits Window {
    title: "File Converter — Settings & Studio";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 1180px;
    min-height: 620px;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: Theme.t-md;
    background: Theme.bg(root.dark_mode);

    in-out property <bool> dark_mode: false;
    in-out property <int> active_tab: 0; // 0: Presets & Studio, 1: History Log, 2: Preferences
    in-out property <string> active_category: "All";
    in-out property <[PresetData]> presets: [];
    in-out property <int> selected_preset_index: 0;
    in-out property <string> search_query: "";
    in-out property <string> status_msg: "Ready";
    in-out property <string> preview_path: "C:\\Output\\sample_track.mp3";
    in-out property <[HistoryItemData]> history_items: [];

    // Editable conversion settings of the selected preset, grouped for display.
    in-out property <[PresetSettingData]> edit_settings: [];
    in-out property <string> new_setting_key: "";
    in-out property <string> new_setting_value: "";
    in-out property <string> settings_notice: "";

    // Form editing properties for selected preset
    in-out property <string> edit_name: "";
    in-out property <string> edit_output_type: "";
    in-out property <string> edit_input_types: "";
    in-out property <string> edit_template: "";
    in-out property <string> edit_post_action: "";

    // Update notification properties
    in-out property <string> update_available_text: "";
    in-out property <string> update_download_url: "";

    // Global UX settings properties
    in-out property <bool> auto_start_on_file_drop: false;
    in-out property <bool> copy_files_in_clipboard_after_conversion: true;
    in-out property <bool> exit_application_when_conversions_finished: true;
    in-out property <float> exit_delay_seconds: 2.0;

    // Fast file selection & drag-and-drop properties
    in-out property <int> pending_files_count: 0;
    in-out property <string> pending_files_summary: "";

    callback save_settings();
    callback register_shell();
    callback new_preset();
    callback duplicate_preset(int);
    callback delete_preset(int);
    callback import_presets();
    callback export_presets();
    callback select_preset(int);
    callback preset_field_changed();
    callback drop_files();
    callback select_files();
    callback native_files_dropped([string]);
    callback start_pending_conversion();
    callback clear_pending_files();
    callback toggle_auto_start(bool);
    callback toggle_copy_clipboard(bool);
    callback toggle_auto_close(bool);
    callback open_update_url(string);
    callback search_query_changed(string);
    callback filter_category_changed(string);
    callback set_output_type(string);
    callback set_post_action(string);
    callback set_path_template(string);
    callback toggle_theme(bool);
    callback set_preset_setting(string, string);
    callback remove_preset_setting(string);
    callback add_preset_setting(string, string);

    VerticalLayout {
        padding: Theme.s-4;
        spacing: Theme.s-3;

        // -------------------------------------------------------------- nav
        Rectangle {
            height: 56px;
            border-radius: Theme.r-lg;
            background: Theme.surface(root.dark_mode);
            border-width: 1px;
            border-color: Theme.border(root.dark_mode);
            drop-shadow-color: Theme.shadow(root.dark_mode);
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 1px;

            HorizontalLayout {
                padding-left: Theme.s-4;
                padding-right: Theme.s-2;
                spacing: Theme.s-3;
                // `space-between` pushed the action buttons past the window
                // edge, so the row stays start-aligned and the actions are
                // pushed right by a stretch spacer instead.
                alignment: start;

                HorizontalLayout {
                    spacing: Theme.s-2;
                    alignment: center;
                    horizontal-stretch: 0;

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: Theme.r-xs;
                        background: Theme.accentSoft(root.dark_mode);

                        IconZap {
                            size: 15px;
                            tint: Theme.accent(root.dark_mode);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }

                    Text {
                        text: "File Converter";
                        font-size: Theme.t-lg;
                        font-weight: Theme.w-semibold;
                        color: Theme.text(root.dark_mode);
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 1px;
                    height: 22px;
                    background: Theme.border(root.dark_mode);
                    vertical-stretch: 0;
                }

                // Navigation tabs
                HorizontalLayout {
                    spacing: Theme.s-1;
                    alignment: center;
                    horizontal-stretch: 0;

                    NavTab {
                        text: "Presets";
                        icon: @image-url("icons/sliders.svg");
                        dark: root.dark_mode;
                        selected: root.active_tab == 0;
                        clicked => { root.active_tab = 0; }
                    }
                    NavTab {
                        text: "History";
                        icon: @image-url("icons/history.svg");
                        dark: root.dark_mode;
                        selected: root.active_tab == 1;
                        clicked => { root.active_tab = 1; }
                    }
                    NavTab {
                        text: "Preferences";
                        icon: @image-url("icons/settings.svg");
                        dark: root.dark_mode;
                        selected: root.active_tab == 2;
                        clicked => { root.active_tab = 2; }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                // Header actions
                HorizontalLayout {
                    spacing: Theme.s-1;
                    alignment: end;
                    horizontal-stretch: 0;

                    UiIconButton {
                        icon: root.dark_mode ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                        dark: root.dark_mode;
                        clicked => {
                            root.dark_mode = !root.dark_mode;
                            root.toggle_theme(root.dark_mode);
                        }
                    }

                    UiButton {
                        text: "Shell integration";
                        kind: ButtonKind.Ghost;
                        dark: root.dark_mode;
                        has-icon: true;
                        icon: @image-url("icons/plug.svg");
                        clicked => { root.register_shell(); }
                    }

                    UiButton {
                        text: "Save";
                        kind: ButtonKind.Primary;
                        dark: root.dark_mode;
                        has-icon: true;
                        icon: @image-url("icons/save.svg");
                        clicked => { root.save_settings(); }
                    }
                }
            }
        }

        // ------------------------------------------------------- update banner
        if root.update_available_text != "" : Rectangle {
            height: 42px;
            background: Theme.warnSoft(root.dark_mode);
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.warn(root.dark_mode);

            HorizontalLayout {
                padding-left: Theme.s-4;
                padding-right: Theme.s-2;
                alignment: space-between;

                Text {
                    text: root.update_available_text;
                    font-size: Theme.t-md;
                    font-weight: Theme.w-medium;
                    color: Theme.warn(root.dark_mode);
                    vertical-alignment: center;
                    overflow: elide;
                }

                UiButton {
                    text: "Download update";
                    kind: ButtonKind.Ghost;
                    dark: root.dark_mode;
                    h: 28px;
                    has-icon: true;
                    icon: @image-url("icons/download.svg");
                    clicked => { root.open_update_url(root.update_download_url); }
                }
            }
        }

        // ------------------------------------------------------- status line
        if root.status_msg != "" : Rectangle {
            height: 30px;
            background: Theme.accentSoft(root.dark_mode);
            border-radius: Theme.r-sm;

            HorizontalLayout {
                padding-left: Theme.s-3;
                padding-right: Theme.s-3;
                Text {
                    text: root.status_msg;
                    font-size: Theme.t-base;
                    font-weight: Theme.w-medium;
                    color: Theme.accent(root.dark_mode);
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        // --------------------------------------------- staged files quick bar
        if root.pending_files_count > 0 : Rectangle {
            height: 52px;
            background: Theme.successSoft(root.dark_mode);
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.success(root.dark_mode);

            HorizontalLayout {
                padding-left: Theme.s-4;
                padding-right: Theme.s-2;
                spacing: Theme.s-3;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Theme.s-2;
                    alignment: start;

                    IconFolder {
                        size: 15px;
                        tint: Theme.success(root.dark_mode);
                    }
                    Text {
                        text: root.pending_files_count + " file(s) ready · " + root.pending_files_summary;
                        font-size: Theme.t-md;
                        font-weight: Theme.w-medium;
                        color: Theme.success(root.dark_mode);
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.s-1;
                    alignment: end;
                    horizontal-stretch: 0;

                    UiButton {
                        text: "Convert with " + root.edit_name;
                        kind: ButtonKind.Primary;
                        dark: root.dark_mode;
                        h: 30px;
                        has-icon: true;
                        icon: @image-url("icons/zap.svg");
                        clicked => { root.start_pending_conversion(); }
                    }

                    UiButton {
                        text: "Clear";
                        kind: ButtonKind.Ghost;
                        dark: root.dark_mode;
                        h: 30px;
                        has-icon: true;
                        icon: @image-url("icons/x.svg");
                        clicked => { root.clear_pending_files(); }
                    }
                }
            }
        }

        // ------------------------------------------------------ tab 0: studio
        if root.active_tab == 0 : HorizontalLayout {
            spacing: Theme.s-3;

            // ---- sidebar: preset library
            UiCard {
                width: 320px;
                horizontal-stretch: 0;
                dark: root.dark_mode;
                pad: Theme.s-3;
                gap: Theme.s-2;

                LineEdit {
                    placeholder-text: "Search presets or formats...";
                    text <=> root.search_query;
                    edited(text) => { root.search_query_changed(text); }
                }

                // Category filter. Split over two rows: five chips do not fit
                // in the 320px sidebar and were being clipped.
                HorizontalLayout {
                    spacing: Theme.s-1;
                    alignment: start;

                    UiChip {
                        text: "All";
                        dark: root.dark_mode;
                        selected: root.active_category == "All";
                        clicked => { root.active_category = "All"; root.filter_category_changed("All"); }
                    }
                    UiChip {
                        text: "Audio";
                        dark: root.dark_mode;
                        tone: Theme.catAudio(root.dark_mode);
                        selected: root.active_category == "Audio";
                        clicked => { root.active_category = "Audio"; root.filter_category_changed("Audio"); }
                    }
                    UiChip {
                        text: "Video";
                        dark: root.dark_mode;
                        tone: Theme.catVideo(root.dark_mode);
                        selected: root.active_category == "Video";
                        clicked => { root.active_category = "Video"; root.filter_category_changed("Video"); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.s-1;
                    alignment: start;

                    UiChip {
                        text: "Image";
                        dark: root.dark_mode;
                        tone: Theme.catImage(root.dark_mode);
                        selected: root.active_category == "Image";
                        clicked => { root.active_category = "Image"; root.filter_category_changed("Image"); }
                    }
                    UiChip {
                        text: "Doc";
                        dark: root.dark_mode;
                        tone: Theme.catDoc(root.dark_mode);
                        selected: root.active_category == "Doc";
                        clicked => { root.active_category = "Doc"; root.filter_category_changed("Doc"); }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: "Presets";
                        font-size: Theme.t-base;
                        font-weight: Theme.w-semibold;
                        color: Theme.textMute(root.dark_mode);
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.presets.length + "";
                        font-size: Theme.t-base;
                        font-weight: Theme.w-semibold;
                        color: Theme.textMute(root.dark_mode);
                        vertical-alignment: center;
                    }
                }

                ScrollView {
                    min-width: 0px;

                    VerticalLayout {
                        spacing: Theme.s-1;
                        for preset in root.presets : PresetRow {
                            data: preset;
                            dark: root.dark_mode;
                            selected: preset.original_index == root.selected_preset_index;
                            clicked => {
                                root.selected_preset_index = preset.original_index;
                                root.select_preset(preset.original_index);
                            }
                        }
                    }
                }

                UiDivider { dark: root.dark_mode; }

                HorizontalLayout {
                    spacing: Theme.s-1;
                    UiButton {
                        text: "New";
                        kind: ButtonKind.Secondary;
                        dark: root.dark_mode;
                        h: 30px;
                        pad-x: Theme.s-2;
                        has-icon: true;
                        icon: @image-url("icons/plus.svg");
                        clicked => { root.new_preset(); }
                    }
                    UiButton {
                        text: "Clone";
                        kind: ButtonKind.Secondary;
                        dark: root.dark_mode;
                        h: 30px;
                        pad-x: Theme.s-2;
                        has-icon: true;
                        icon: @image-url("icons/copy.svg");
                        clicked => { root.duplicate_preset(root.selected_preset_index); }
                    }
                    UiButton {
                        text: "Delete";
                        kind: ButtonKind.Danger;
                        dark: root.dark_mode;
                        h: 30px;
                        pad-x: Theme.s-2;
                        has-icon: true;
                        icon: @image-url("icons/trash.svg");
                        clicked => { root.delete_preset(root.selected_preset_index); }
                    }
                }

                HorizontalLayout {
                    spacing: Theme.s-1;
                    UiButton {
                        text: "Import";
                        kind: ButtonKind.Ghost;
                        dark: root.dark_mode;
                        h: 28px;
                        pad-x: Theme.s-2;
                        has-icon: true;
                        icon: @image-url("icons/download.svg");
                        clicked => { root.import_presets(); }
                    }
                    UiButton {
                        text: "Export";
                        kind: ButtonKind.Ghost;
                        dark: root.dark_mode;
                        h: 28px;
                        pad-x: Theme.s-2;
                        has-icon: true;
                        icon: @image-url("icons/upload.svg");
                        clicked => { root.export_presets(); }
                    }
                }
            }

            // ---- studio pane
            UiCard {
                dark: root.dark_mode;
                pad: 0px;
                gap: 0px;

                ScrollView {
                    min-width: 0px;
                    // A Slint ScrollView otherwise reports its content's minimum
                    // width as its own, which let the studio pane grow past the
                    // window and silently clip the right edge of every field.

                    VerticalLayout {
                        padding: Theme.s-5;
                        spacing: Theme.s-4;

                        Text {
                            text: "Preset studio";
                            font-size: Theme.t-xl;
                            font-weight: Theme.w-semibold;
                            color: Theme.text(root.dark_mode);
                            overflow: elide;
                        }

                        UiDivider { dark: root.dark_mode; }

                        // Preset label
                        HorizontalLayout {
                            spacing: Theme.s-3;
                            UiFieldLabel { text: "Preset label"; dark: root.dark_mode; }
                            LineEdit {
                                text <=> root.edit_name;
                                edited => { root.preset_field_changed(); }
                            }
                        }

                        // Target output format
                        VerticalLayout {
                            spacing: Theme.s-2;

                            HorizontalLayout {
                                spacing: Theme.s-3;
                                UiFieldLabel { text: "Target format"; dark: root.dark_mode; }
                                LineEdit {
                                    text <=> root.edit_output_type;
                                    edited => { root.preset_field_changed(); }
                                }
                            }

                            // Quick format picker. Full pane width, no
                            // label-column indent: eight chips do not fit
                            // beside a 130px label.
                            HorizontalLayout {
                                spacing: Theme.s-1;

                                Text {
                                    text: "Quick pick";
                                    width: 72px;
                                    font-size: Theme.t-sm;
                                    font-weight: Theme.w-semibold;
                                    color: Theme.textMute(root.dark_mode);
                                    vertical-alignment: center;
                                }

                                UiChip {
                                    text: "MP3";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Mp3";
                                    clicked => { root.set_output_type("Mp3"); }
                                }
                                UiChip {
                                    text: "FLAC";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Flac";
                                    clicked => { root.set_output_type("Flac"); }
                                }
                                UiChip {
                                    text: "PNG";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Png";
                                    clicked => { root.set_output_type("Png"); }
                                }
                                UiChip {
                                    text: "JPG";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Jpg";
                                    clicked => { root.set_output_type("Jpg"); }
                                }
                                UiChip {
                                    text: "WEBP";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Webp";
                                    clicked => { root.set_output_type("Webp"); }
                                }
                                UiChip {
                                    text: "PDF";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Pdf";
                                    clicked => { root.set_output_type("Pdf"); }
                                }
                                UiChip {
                                    text: "MP4";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Mp4";
                                    clicked => { root.set_output_type("Mp4"); }
                                }
                                UiChip {
                                    text: "MKV";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    selected: root.edit_output_type == "Mkv";
                                    clicked => { root.set_output_type("Mkv"); }
                                }
                            }
                        }

                        // Compatible input extensions
                        HorizontalLayout {
                            spacing: Theme.s-3;
                            UiFieldLabel { text: "Input extensions"; dark: root.dark_mode; }
                            LineEdit {
                                placeholder-text: "e.g. wav, flac, mp3, mkv, jpg (leave empty to allow all)";
                                text <=> root.edit_input_types;
                                edited => { root.preset_field_changed(); }
                            }
                        }

                        // Path template
                        VerticalLayout {
                            spacing: Theme.s-2;

                            HorizontalLayout {
                                spacing: Theme.s-3;
                                UiFieldLabel { text: "Path template"; dark: root.dark_mode; }
                                LineEdit {
                                    placeholder-text: "(p)(f)";
                                    text <=> root.edit_template;
                                    edited => { root.preset_field_changed(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.s-1;

                                Text {
                                    text: "Presets";
                                    width: 72px;
                                    font-size: Theme.t-sm;
                                    font-weight: Theme.w-semibold;
                                    color: Theme.textMute(root.dark_mode);
                                    vertical-alignment: center;
                                }

                                UiChip {
                                    text: "Same folder";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    clicked => { root.set_path_template("(p)(f)"); }
                                }
                                UiChip {
                                    text: "Subfolder";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    clicked => { root.set_path_template("(p)Converted\\(f)"); }
                                }
                                UiChip {
                                    text: "With date";
                                    dark: root.dark_mode;
                                    h: 24px;
                                    clicked => { root.set_path_template("(p)(f)_(d:yyyyMMdd)"); }
                                }
                            }
                        }

                        // Live output path preview
                        Rectangle {
                            background: Theme.surface2(root.dark_mode);
                            border-radius: Theme.r-md;
                            border-width: 1px;
                            border-color: Theme.border(root.dark_mode);

                            VerticalLayout {
                                padding: Theme.s-3;
                                spacing: Theme.s-1;

                                Text {
                                    text: "Live output path";
                                    font-size: Theme.t-sm;
                                    font-weight: Theme.w-semibold;
                                    color: Theme.textMute(root.dark_mode);
                                }
                                Text {
                                    text: root.preview_path;
                                    font-size: Theme.t-md;
                                    font-weight: Theme.w-medium;
                                    color: Theme.accent(root.dark_mode);
                                    overflow: elide;
                                }
                            }
                        }

                        // Post-conversion action
                        HorizontalLayout {
                            spacing: Theme.s-3;
                            UiFieldLabel { text: "After conversion"; dark: root.dark_mode; }

                            HorizontalLayout {
                                spacing: Theme.s-1;
                                UiChip {
                                    text: "Keep original";
                                    dark: root.dark_mode;
                                    h: 30px;
                                    selected: root.edit_post_action == "None";
                                    clicked => { root.set_post_action("None"); }
                                }
                                UiChip {
                                    text: "Move to archive";
                                    dark: root.dark_mode;
                                    h: 30px;
                                    tone: Theme.warn(root.dark_mode);
                                    selected: root.edit_post_action == "MoveInArchiveFolder";
                                    clicked => { root.set_post_action("MoveInArchiveFolder"); }
                                }
                                UiChip {
                                    text: "Delete permanently";
                                    dark: root.dark_mode;
                                    h: 30px;
                                    tone: Theme.danger(root.dark_mode);
                                    selected: root.edit_post_action == "Delete";
                                    clicked => { root.set_post_action("Delete"); }
                                }
                            }
                        }

                        // Conversion settings editor
                        UiCard {
                            dark: root.dark_mode;
                            pad: Theme.s-3;
                            gap: Theme.s-2;
                            fill: Theme.surface2(root.dark_mode);
                            radius: Theme.r-md;

                            Text {
                                text: "Conversion settings";
                                font-size: Theme.t-md;
                                font-weight: Theme.w-semibold;
                                color: Theme.text(root.dark_mode);
                            }

                            Text {
                                text: "Engine options for this preset: bitrate, quality, scale, rotation. Leave a field empty to use the default.";
                                font-size: Theme.t-sm;
                                color: Theme.textMute(root.dark_mode);
                                wrap: word-wrap;
                            }

                            if root.edit_settings.length == 0 : Text {
                                text: "No settings apply to this output type.";
                                font-size: Theme.t-sm;
                                color: Theme.textMute(root.dark_mode);
                            }

                            for row in root.edit_settings : VerticalLayout {
                                spacing: Theme.s-1;

                                if row.is_group_start : Text {
                                    text: row.group;
                                    font-size: Theme.t-xs;
                                    font-weight: Theme.w-semibold;
                                    color: Theme.accent(root.dark_mode);
                                }

                                HorizontalLayout {
                                    spacing: Theme.s-2;
                                    padding-top: 2px;

                                    VerticalLayout {
                                        width: 120px;
                                        spacing: 0px;
                                        Text {
                                            text: row.label;
                                            font-size: Theme.t-base;
                                            font-weight: Theme.w-medium;
                                            color: Theme.textDim(root.dark_mode);
                                        }
                                        Text {
                                            text: row.hint;
                                            font-size: Theme.t-xs;
                                            color: Theme.textMute(root.dark_mode);
                                            wrap: word-wrap;
                                        }
                                    }

                                    // Free-text values get an editor.
                                    if row.choices.length == 0 : LineEdit {
                                        placeholder-text: "default";
                                        text: row.value;
                                        edited => { root.set_preset_setting(row.key, self.text); }
                                    }

                                    if row.is_custom : UiIconButton {
                                        icon: @image-url("icons/x.svg");
                                        dark: root.dark_mode;
                                        size: 26px;
                                        tint: Theme.danger(root.dark_mode);
                                        clicked => { root.remove_preset_setting(row.key); }
                                    }
                                }

                                // Short enumerated values become clickable
                                // chips. Slint has no FlowLayout, so the chip
                                // row is a plain HorizontalLayout and the
                                // descriptor data keeps these lists to <= 4.
                                if row.choices.length > 0 : HorizontalLayout {
                                    padding-left: 128px;
                                    spacing: Theme.s-1;
                                    for choice in row.choices : UiChip {
                                        text: choice;
                                        dark: root.dark_mode;
                                        h: 24px;
                                        selected: row.value == choice;
                                        clicked => { root.set_preset_setting(row.key, choice); }
                                    }
                                }
                            }

                            UiDivider { dark: root.dark_mode; }

                            // Escape hatch for keys the UI does not know about.
                            // One editor per row: two LineEdits side by side
                            // made this the widest row in the pane and dragged
                            // the studio past the window edge.
                            HorizontalLayout {
                                spacing: Theme.s-2;
                                Text {
                                    text: "Custom key";
                                    width: 120px;
                                    font-size: Theme.t-sm;
                                    font-weight: Theme.w-medium;
                                    color: Theme.textMute(root.dark_mode);
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    placeholder-text: "e.g. AudioNormalize";
                                    text <=> root.new_setting_key;
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.s-2;
                                Text {
                                    text: "Custom value";
                                    width: 120px;
                                    font-size: Theme.t-sm;
                                    font-weight: Theme.w-medium;
                                    color: Theme.textMute(root.dark_mode);
                                    vertical-alignment: center;
                                }
                                LineEdit {
                                    placeholder-text: "Value";
                                    text <=> root.new_setting_value;
                                }
                                UiButton {
                                    text: "Add";
                                    kind: ButtonKind.Secondary;
                                    dark: root.dark_mode;
                                    h: 30px;
                                    pad-x: Theme.s-3;
                                    clicked => {
                                        root.add_preset_setting(root.new_setting_key, root.new_setting_value);
                                    }
                                }
                            }

                            if root.settings_notice != "" : Text {
                                text: root.settings_notice;
                                font-size: Theme.t-sm;
                                font-weight: Theme.w-medium;
                                color: root.settings_notice == "✓ Added" || root.settings_notice == "✓ Removed" || root.settings_notice == "✓ Updated"
                                    ? Theme.success(root.dark_mode) : Theme.danger(root.dark_mode);
                                wrap: word-wrap;
                            }
                        }

                        // Drop zone
                        Rectangle {
                            height: 116px;
                            border-radius: Theme.r-lg;
                            background: root.pending_files_count > 0
                                ? Theme.successSoft(root.dark_mode)
                                : Theme.surface2(root.dark_mode);
                            border-width: 1px;
                            border-color: root.pending_files_count > 0
                                ? Theme.success(root.dark_mode)
                                : Theme.borderStrong(root.dark_mode);
                            animate background { duration: Theme.base; }
                            animate border-color { duration: Theme.base; }

                            VerticalLayout {
                                alignment: center;
                                spacing: Theme.s-1;
                                padding: Theme.s-3;

                                Icon {
                                    source: root.pending_files_count > 0
                                        ? @image-url("icons/check.svg")
                                        : @image-url("icons/folder.svg");
                                    size: 22px;
                                    tint: root.pending_files_count > 0
                                        ? Theme.success(root.dark_mode)
                                        : Theme.textMute(root.dark_mode);
                                }

                                Text {
                                    text: root.pending_files_count > 0
                                        ? root.pending_files_count + " file(s) staged and ready"
                                        : "Click or drop files here";
                                    font-size: Theme.t-lg;
                                    font-weight: Theme.w-semibold;
                                    color: root.pending_files_count > 0
                                        ? Theme.success(root.dark_mode)
                                        : Theme.text(root.dark_mode);
                                    horizontal-alignment: center;
                                }

                                Text {
                                    text: root.pending_files_count > 0
                                        ? root.pending_files_summary + " · click to stage more"
                                        : "Drop files anywhere in this window to convert using " + root.edit_name;
                                    font-size: Theme.t-base;
                                    color: Theme.textMute(root.dark_mode);
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }

                                if root.pending_files_count > 0 : HorizontalLayout {
                                    alignment: center;
                                    spacing: Theme.s-1;

                                    UiButton {
                                        text: "Convert now";
                                        kind: ButtonKind.Primary;
                                        dark: root.dark_mode;
                                        h: 28px;
                                        has-icon: true;
                                        icon: @image-url("icons/zap.svg");
                                        clicked => { root.start_pending_conversion(); }
                                    }

                                    UiButton {
                                        text: "Clear queue";
                                        kind: ButtonKind.Ghost;
                                        dark: root.dark_mode;
                                        h: 28px;
                                        has-icon: true;
                                        icon: @image-url("icons/x.svg");
                                        clicked => { root.clear_pending_files(); }
                                    }
                                }
                            }

                            TouchArea {
                                clicked => { root.select_files(); }
                            }
                        }
                    }
                }
            }
        }

        // ----------------------------------------------------- tab 1: history
        if root.active_tab == 1 : UiCard {
            dark: root.dark_mode;
            pad: Theme.s-4;
            gap: Theme.s-3;

            Text {
                text: "Conversion history";
                font-size: Theme.t-xl;
                font-weight: Theme.w-semibold;
                color: Theme.text(root.dark_mode);
            }

            ScrollView {
                min-width: 0px;

                VerticalLayout {
                    spacing: Theme.s-1;
                    for item in root.history_items : HistoryRow {
                        data: item;
                        dark: root.dark_mode;
                    }
                }
            }
        }

        // ------------------------------------------------- tab 2: preferences
        if root.active_tab == 2 : UiCard {
            dark: root.dark_mode;
            pad: 0px;
            gap: 0px;

            ScrollView {
                min-width: 0px;

                VerticalLayout {
                    padding: Theme.s-5;
                    spacing: Theme.s-3;

                    Text {
                        text: "Preferences";
                        font-size: Theme.t-xl;
                        font-weight: Theme.w-semibold;
                        color: Theme.text(root.dark_mode);
                    }

                    UiDivider { dark: root.dark_mode; }

                    PrefCard {
                        title: "Zero-click auto-start on file drop";
                        hint: "Immediately begin conversion using the selected preset as soon as files are dropped into the window.";
                        dark: root.dark_mode;
                        checked <=> root.auto_start_on_file_drop;
                        toggled(v) => { root.toggle_auto_start(v); }
                    }

                    PrefCard {
                        title: "Copy output paths to clipboard";
                        hint: "Automatically copy the newly generated destination file paths to the Windows clipboard once conversion finishes.";
                        dark: root.dark_mode;
                        checked <=> root.copy_files_in_clipboard_after_conversion;
                        toggled(v) => { root.toggle_copy_clipboard(v); }
                    }

                    PrefCard {
                        title: "Auto-close window when finished";
                        hint: "Automatically dismiss the conversion progress window after all files have finished processing.";
                        dark: root.dark_mode;
                        checked <=> root.exit_application_when_conversions_finished;
                        toggled(v) => { root.toggle_auto_close(v); }
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Progress window
// ---------------------------------------------------------------------------

export component ProgressWindow inherits Window {
    title: "File Converter — Progress";
    preferred-width: 720px;
    preferred-height: 520px;
    min-width: 620px;
    min-height: 420px;
    default-font-family: "Segoe UI Variable Text";
    default-font-size: Theme.t-md;
    background: Theme.bg(root.dark_mode);

    in-out property <bool> dark_mode: false;
    in-out property <string> preset_name: "";
    in-out property <float> overall_progress: 0.0;
    in-out property <string> overall_status_text: "Converting files...";
    in-out property <[JobProgressData]> jobs: [];
    in-out property <bool> is_finished: false;

    callback open_output_folder();
    callback copy_output_paths();
    callback cancel_job(int);
    callback close_window();
    callback toggle_theme(bool);

    VerticalLayout {
        padding: Theme.s-4;
        spacing: Theme.s-3;

        // Header
        Rectangle {
            height: 72px;
            background: Theme.surface(root.dark_mode);
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border(root.dark_mode);
            drop-shadow-color: Theme.shadow(root.dark_mode);
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 1px;

            HorizontalLayout {
                padding-left: Theme.s-5;
                padding-right: Theme.s-2;
                spacing: Theme.s-3;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;

                    HorizontalLayout {
                        spacing: Theme.s-2;
                        IconZap {
                            size: 15px;
                            tint: Theme.accent(root.dark_mode);
                        }
                        Text {
                            text: root.preset_name;
                            font-size: Theme.t-lg;
                            font-weight: Theme.w-semibold;
                            color: Theme.text(root.dark_mode);
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.overall_status_text;
                        font-size: Theme.t-md;
                        color: Theme.textMute(root.dark_mode);
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.s-2;
                    alignment: center;
                    horizontal-stretch: 0;

                    Text {
                        text: Math.round(root.overall_progress * 100) + "%";
                        font-size: Theme.t-2xl;
                        font-weight: Theme.w-semibold;
                        color: Theme.accent(root.dark_mode);
                        vertical-alignment: center;
                    }

                    UiIconButton {
                        icon: root.dark_mode ? @image-url("icons/sun.svg") : @image-url("icons/moon.svg");
                        dark: root.dark_mode;
                        clicked => {
                            root.dark_mode = !root.dark_mode;
                            root.toggle_theme(root.dark_mode);
                        }
                    }
                }
            }
        }

        ProgressIndicator {
            progress: root.overall_progress;
        }

        // Jobs
        UiCard {
            dark: root.dark_mode;
            pad: 0px;
            gap: 0px;

            ScrollView {
                min-width: 0px;

                VerticalLayout {
                    padding: Theme.s-3;
                    spacing: Theme.s-2;
                    for job in root.jobs : JobRow {
                        data: job;
                        dark: root.dark_mode;
                        cancel(id) => { root.cancel_job(id); }
                    }
                }
            }
        }

        // Footer actions
        Rectangle {
            height: 54px;
            background: Theme.surface(root.dark_mode);
            border-radius: Theme.r-lg;
            border-width: 1px;
            border-color: Theme.border(root.dark_mode);

            HorizontalLayout {
                padding-left: Theme.s-3;
                padding-right: Theme.s-3;
                spacing: Theme.s-1;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Theme.s-1;
                    alignment: start;

                    UiButton {
                        text: "Open folder";
                        kind: ButtonKind.Secondary;
                        dark: root.dark_mode;
                        has-icon: true;
                        icon: @image-url("icons/folder-open.svg");
                        clicked => { root.open_output_folder(); }
                    }

                    UiButton {
                        text: "Copy paths";
                        kind: ButtonKind.Secondary;
                        dark: root.dark_mode;
                        has-icon: true;
                        icon: @image-url("icons/copy.svg");
                        clicked => { root.copy_output_paths(); }
                    }
                }

                UiButton {
                    text: root.is_finished ? "Close window" : "Close";
                    kind: root.is_finished ? ButtonKind.Primary : ButtonKind.Secondary;
                    dark: root.dark_mode;
                    has-icon: true;
                    icon: root.is_finished ? @image-url("icons/check.svg") : @image-url("icons/x.svg");
                    clicked => { root.close_window(); }
                }
            }
        }
    }
}
